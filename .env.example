# Copy to .env (git-ignored). Read by compose and by the server's first start.

# First user, created on first start.
MCP_VAULT_ADMIN_USER=me
MCP_VAULT_ADMIN_PASSWORD=

# Host folder with your notes (mounted into the container as /vault).
# Tilde (~) is not expanded here – use an absolute path, e.g. /home/ubuntu/vault.
MCP_VAULT_DIR=./vault

# Host folder for the index database (mounted into the container as /data).
MCP_VAULT_DATA_DIR=./data

# Port on the host, forwarded to the container's port 8787.
MCP_VAULT_PORT=8787

# Set to "true" when running behind a reverse proxy (Caddy, nginx, Tailscale serve, …).
MCP_VAULT_TRUST_PROXY=false
